[{"userId":"uid_1790793702136_3gr3lhtj8","characterId":"4102444800000","name":"2026/10/1","type":"this-moment","createdAt":1790795582143,"lastActiveAt":1790795582143,"_id":2},{"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","name":"2026/10/2","type":"this-moment","createdAt":1790879965856,"lastActiveAt":1790935637781,"_id":7,"completed":true,"completedAt":1790949592111},{"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","name":"深夜路灯下拽住你的手腕","type":"this-moment","scenarioOutline":"深夜路灯下拽住你的手腕","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"user","text":"我晚上去哪睡啊"},{"role":"user","text":"没定酒店"},{"role":"char","text":"？？？？？？"},{"role":"char","text":"你认真的假的啊？！"},{"role":"char","text":"沈栖迟猛地在路灯下刹住脚步，拿着手机的手剧烈一抖，转过头满脸写着不可置信地瞪着你，耳根子唰地一下红透了。"},{"role":"char","text":"[語音消息]"},{"role":"char","text":"等等，我现在看美团"},{"role":"char","text":"大学城附近万一满房了怎么办啊……"},{"role":"user","text":"一脸无语地看着他"},{"role":"user","text":"得得得，你别看了"},{"role":"user","text":"肯定没了，国庆节，这还在市中心，有就怪了"},{"role":"user","text":"拜了，睡大街去了"},{"role":"user","text":"朝他挥挥手转身就走"},{"role":"char","text":"沈栖迟见她真的转身迈步，脑子里那根紧绷的弦瞬间崩断，连手里的手机都来不及揣回兜里，大步流星跨上前一把攥住她的手腕，硬生生把人拉了回来。"},{"role":"char","text":"你给我站住！"},{"role":"char","text":"他的手掌温热而宽大，指节因为用力而微微泛白，却又小心翼翼地没掐疼她。夜风吹乱了他蓬松的棕发，灰蓝色的眼睛里全是又急又恼的慌乱，耳根一路红到了锁骨。"},{"role":"char","text":"大不了……大不了去我家里"},{"role":"char","text":"我爸妈这几天不在市区，家里就我一个人……但我先声明，我是看你可怜才带你回去的，你少脑补些有的没的！"},{"role":"char","text":""},{"role":"char","text":""}]},"createdAt":1790950564317,"lastActiveAt":1790958340761,"_id":10,"completed":true,"completedAt":1790958692236}]