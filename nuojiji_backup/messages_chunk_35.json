-492e-956f-8ed62d7792b2","_id":2448},{"id":1791728566123,"text":"笑死我了哈哈哈哈哈","sender":"me","time":"15:18","timestamp":1791271126405,"replyTo":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2449},{"id":1791728566124,"text":"哎好好好~不笑不笑了","sender":"me","time":"15:19","timestamp":1791271155746,"replyTo":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2450},{"id":1791728566125,"text":"[語音：狗狗最乖了，咱们乖乖去吃饭好不好呀~乖乖的主人才喜欢哟]","voiceText":"狗狗最乖了，咱们乖乖去吃饭好不好呀~乖乖的主人才喜欢哟","sender":"me","isVoice":true,"voice":true,"time":"15:20","timestamp":1791271202105,"audioDuration":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2451},{"id":1791728566127,"text":"沈栖迟戴着耳机，把那条只有几秒的语音反反复复听了三遍。听到那句轻飘飘的“主人”时，他像被微弱的电流击中了一样，整个人猛地蜷缩进被子里。他把滚烫的脸死死埋进枕头，咬着下唇，心脏跳得快要撞破胸腔。","rawContent":"沈栖迟戴着耳机，把那条只有几秒的语音反反复复听了三遍。听到那句轻飘飘的“主人”时，他像被微弱的电流击中了一样，整个人猛地蜷缩进被子里。他把滚烫的脸死死埋进枕头，咬着下唇，心脏跳得快要撞破胸腔。","isHtml":false,"sticker":null,"sender":"them","time":"15:20","timestamp":1791271249212,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"type":"state","hasThinking":true,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2452},{"id":1791728566128,"text":"你……你干嘛突然自称那个啊！","rawContent":"你……你干嘛突然自称那个啊！","isHtml":false,"sticker":null,"sender":"them","time":"15:20","timestamp":1791271256762,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2453},{"id":1791728566129,"text":"我都说了我还在宿舍！万一室友醒了听见怎么办！","rawContent":"我都说了我还在宿舍！万一室友醒了听见怎么办！","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271261111,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"subtext":"明明戴着耳机，但还是羞耻得要命……可是又好喜欢……","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2454},{"id":1791728566130,"text":"嘴上虽然拼命抗议着，但他还是立刻掀开被子坐了起来，连拖鞋都没顾上穿，乖乖点开了手机里的外卖软件。","rawContent":"嘴上虽然拼命抗议着，但他还是立刻掀开被子坐了起来，连拖鞋都没顾上穿，乖乖点开了手机里的外卖软件。","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271268228,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2455},{"id":1791728566131,"text":"我点就是了……这就去点","rawContent":"我点就是了……这就去点","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271273377,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2456},{"id":1791728566132,"text":"点了一份黄焖鸡米饭……","rawContent":"点了一份黄焖鸡米饭……","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271276448,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2457},{"id":1791728566133,"text":"这下算乖了吧……","rawContent":"这下算乖了吧……","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271283476,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":2458},{"id":1791728566134,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"15:21","timestamp":1791271285321,"roundId":"round_1791271211600_14g8fvn2i","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"那……我乖乖吃饭的话，你晚上能不能再用刚才那种语气……多跟我说几句话？你说过喜欢乖的……不许骗人。","minimaxTimbreId":"moss_audio_fd8becd1-9d42-11f1-a083-168c55c08bf3","voiceLanguage":"auto","voiceEmotion":"shy","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","chara