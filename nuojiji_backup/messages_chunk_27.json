icker":null,"sender":"them","time":"17:55","timestamp":1791194140853,"roundId":"round_1791194073656_yxjv9r838","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":1956},{"id":1791647521111,"text":"你说话拐弯抹角的，我怎么听得出来啊！","rawContent":"你说话拐弯抹角的，我怎么听得出来啊！","isHtml":false,"sticker":null,"sender":"them","time":"17:55","timestamp":1791194144503,"roundId":"round_1791194073656_yxjv9r838","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":1957},{"id":1791647521114,"text":"不许叫笨狗！我哪里笨了……","rawContent":"不许叫笨狗！我哪里笨了……","isHtml":false,"sticker":null,"sender":"them","time":"17:55","timestamp":1791194156028,"roundId":"round_1791194073656_yxjv9r838","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":1960},{"id":1791647521115,"text":"他嘴上虽然凶巴巴地抗议着，嘴角却控制不住地往上扬了一点。虽然被骂了笨，但知道她其实并不反感自己那种黏人的管束，心里那点委屈突然就被顺平了。","rawContent":"他嘴上虽然凶巴巴地抗议着，嘴角却控制不住地往上扬了一点。虽然被骂了笨，但知道她其实并不反感自己那种黏人的管束，心里那点委屈突然就被顺平了。","isHtml":false,"sticker":null,"sender":"them","time":"17:56","timestamp":1791194163267,"roundId":"round_1791194073656_yxjv9r838","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":1961},{"id":1791647521116,"text":"那……那我占有欲强怎么了……","rawContent":"那……那我占有欲强怎么了……","isHtml":false,"sticker":null,"sender":"them","time":"17:56","timestamp":1791194170299,"roundId":"round_1791194073656_yxjv9r838","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":1962},{"id":1791647521117,"text":"你才刚走，我就已经想你想得要疯了，强一点不是应该的吗","rawContent":"你才刚走，我就已经想你想得要疯了，强一点不是应该的吗","isHtml":false,"sticker":null,"sender":"them","time":"17:56","timestamp":1791194176217,"roundId":"round_1791194073656_yxjv9