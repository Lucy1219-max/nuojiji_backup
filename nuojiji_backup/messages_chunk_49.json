":3488},{"id":1791809611194,"text":"我错了！！！","rawContent":"我错了！！！","isHtml":false,"sticker":null,"sender":"them","time":"00:02","timestamp":1791475363225,"roundId":"round_1791475294316_kort6ple1","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":3489},{"id":1791809611195,"text":"到到到！肯定能到！到了我第一时间去拿！","rawContent":"到到到！肯定能到！到了我第一时间去拿！","isHtml":false,"sticker":null,"sender":"them","time":"00:02","timestamp":1791475368516,"roundId":"round_1791475294316_kort6ple1","generatedMode":false,"translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":3490},{"id":1791809611196,"text":"你别走啊……","rawContent":"你别走啊……","isHtml":false,"sticker":null,"sender":"them","time":"00:02","timestamp":1791475370855,"roundId":"round_1791475294316_kort6ple1","generatedMode":false,"subtext":"你不要丢下我一个人","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":3491},{"id":1791809611198,"text":"他把脸深深埋进枕头里，深深吸了一口气，仿佛这样就能隔着屏幕汲取到她身上的葡萄香气。耳根的红晕已经蔓延到了脖颈，想到那个快递和她刚才说的话，腰眼处泛起一阵陌生的酥麻。","rawContent":"他把脸深深埋进枕头里，深深吸了一口气，仿佛这样就能隔着屏幕汲取到她身上的葡萄香气。耳根的红晕已经蔓延到了脖颈，想到那个快递和她刚才说的话，腰眼处泛起一阵陌生的酥麻。","isHtml":false,"sticker":null,"sender":"them","time":"00:03","timestamp":1791475384951,"roundId":"round_1791475294316_kort6ple1","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790793702136_3gr3lhtj8","characterId":"045464e8-a183-492e-956f-8ed62d7792b2","_id":3493},{"id":1791809611199,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:03","timestamp":1791475386472,"roundId":"round_1791475294316_kort6ple1","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"……宝宝你别走好不好？就算你要睡，你也把连麦打开……我保证闭嘴，绝对不吵你。我就是想听着你的呼吸声，不然我满脑子都是你刚才说的那些话……还有那个破快递……我根本睡不着……求你了，收留我一晚嘛……","minimaxTimbreId":"moss_audio_fd8becd1-9d42-11f1-a083-168c55c08bf3","voiceLanguage":"auto","voiceEmo